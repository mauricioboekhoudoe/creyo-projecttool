{
  "name": "creyo-projecttool",
  "private": true,
  "version": "1.0.0",
  "description": "Shared project tool for Get Creyo (Mauricio and Charona), behind Cloudflare Access.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --test test/*.test.js",
